# API server base URL. Must include /api/v1 (the server mounts its routes there).
# On a physical device use your machine's LAN IP, not localhost.
SERVER_URL=http://localhost:9201/api/v1
# Hasura GraphQL HTTP + WebSocket endpoints
DATAHUB=http://localhost:9203/v1/graphql
DATAHUB_WS=ws://localhost:9203/v1/graphql
# Only needed for `yarn generate-types` (GraphQL codegen)
HASURA_ADMIN_SECRET=123
