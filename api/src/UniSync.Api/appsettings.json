{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "JwtSecret": "",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Otp": {
    "Length": 6,
    "Lifetime": "00:05:00",
    "MaxAttempts": 5,
    "MaxSendsPerHour": 3,
    "BcryptWorkFactor": 10
  },
  "Sms": {
    "Provider": "bulksmsbd"
  },
  "Campus": {
    "TimeZone": "Asia/Dhaka"
  },
  "RateLimits": {
    "CodeRequestsPerHourPerIp": 10,
    "VerifyAttemptsPer15MinPerIp": 30
  },
  "Push": {
    "Enabled": false,
    "FcmServiceAccountJson": "",
    "MaxAge": "01:00:00"
  }
}
