{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check-all.sh:*)",
      "Bash(python3 scripts/check-hasura-metadata.py)",
      "Bash(yarn test:*)",
      "Bash(yarn typecheck:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn format:check:*)",
      "Bash(yarn build:*)",
      "Bash(yarn -s test:*)",
      "Bash(yarn -s typecheck:*)",
      "Bash(yarn -s lint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx prettier --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./server/service-account.json)",
      "Bash(flyctl deploy:*)",
      "Bash(fly deploy:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-web.sh\""
          }
        ]
      }
    ]
  }
}
