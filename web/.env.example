# Origin of the UniSync .NET API, without /api/v1 (server-side only: the
# browser talks to this site's own /api/v1 proxy, never to the API directly).
API_URL=http://localhost:9202

# Optional. Same value as the API's RateLimits__TrustedProxySecret. With it, this
# server forwards each visitor's address (x-real-ip / x-forwarded-for) so the
# API's sign-in limits apply per visitor, not to this server as a whole. Set it
# only where the host overwrites those headers itself (Vercel does).
API_PROXY_SECRET=
