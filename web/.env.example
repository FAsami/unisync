# API server base URL, including the /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:9201/api/v1
# Hasura GraphQL endpoint
NEXT_PUBLIC_HASURA_ENDPOINT=http://localhost:9203/v1/graphql
# Server-only secret used to encrypt the OTP verify context (any long random string)
ENCRYPT_SECRET=change-me-to-a-long-random-string
